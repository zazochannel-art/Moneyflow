# ---------------------------------------------------------------------------
# MONEYFLOW — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API). Both are safe to expose to the browser:
# the anon key only ever sees data Row Level Security allows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public origin, used to build the password-reset callback link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional ---------------------------------------------------------------

# AI Assistant. Without a key the assistant still answers from your real data
# using the built-in deterministic engine; with one it also writes the reply.
# Server-side only — never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Exchange-rate provider for multi-currency accounts: "frankfurter" (default,
# free, no key) or "static" (fixed table, offline).
EXCHANGE_RATES_PROVIDER=frankfurter

# Notificări push (opțional). Fără ele, ecranul de Setări spune că nu sunt
# configurate, în loc să ofere un comutator care nu face nimic.
# Generează perechea o dată:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@exemplu.md

# The scheduled job that posts recurring charges. Vercel presents CRON_SECRET as
# a bearer token on /api/cron/recurring; the route refuses anything else. The
# service role key is used there and nowhere else, because that job acts for
# every user at once and nobody is signed in to authorise it — keep it out of
# any client-visible variable.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

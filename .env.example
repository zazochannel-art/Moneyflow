# ---------------------------------------------------------------------------
# MONEYFLOW — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API). Both are safe to expose to the browser:
# the anon key only ever sees data Row Level Security allows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public origin, used to build the password-reset callback link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional ---------------------------------------------------------------

# AI Assistant. Without a key the assistant still answers from your real data
# using the built-in deterministic engine; with one it also writes the reply.
# Server-side only — never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Exchange-rate provider for multi-currency accounts: "frankfurter" (default,
# free, no key) or "static" (fixed table, offline).
EXCHANGE_RATES_PROVIDER=frankfurter
